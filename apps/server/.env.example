# Supabase — get these from your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key bypasses RLS — only use server-side, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — get this from platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Model to use — gpt-4o-mini (cheaper/faster) or gpt-4o (more reliable on complex tasks)
OPENAI_MODEL=gpt-4o-mini

# Server
PORT=3001
